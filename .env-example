# Copy this file to .env and fill in real keys.
# Do not commit your real .env file.

# DeepSeek through the OpenAI SDK-compatible client.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Optional. Only needed when you want LlamaParse fallback/enhanced parsing.
LLAMA_CLOUD_API_KEY=replace_with_your_llama_cloud_api_key

# Optional. Defaults to sentence-transformers/all-MiniLM-L6-v2.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
